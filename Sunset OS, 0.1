  // -------------------- Terminal --------------------
  function openTerminal(){
    const term = document.createElement("div");
    term.className = "term";

    const out = document.createElement("div");
    out.className = "termOut";

    const row = document.createElement("div");
    row.className = "termRow";

    const prompt = document.createElement("div");
    prompt.className = "prompt";
    prompt.textContent = "sunset@os:~$";

    const inp = document.createElement("input");
    inp.className = "input";
    inp.style.flex = "1";
    inp.placeholder = "help";

    row.appendChild(prompt);
    row.appendChild(inp);

    term.appendChild(out);
    term.appendChild(row);

    function print(line, color=""){
      const div = document.createElement("div");
      div.textContent = line;
      if(color) div.style.color = color;
      out.appendChild(div);
      out.scrollTop = out.scrollHeight;
    }

    function resolvePath(p){
      if(!p) return "/";
      if(p === "~") return "/Documents";
      if(!p.startsWith("/")) return "/"+p;
      return p;
    }

    function listDir(path){
      if(!isDir(path)) return null;
      return (state.fs[path].children||[]).slice().sort((a,b)=>a.localeCompare(b,"fr"));
    }

    function cmdHelp(){
      print("Commandes:");
      print("  help");
      print("  time");
      print("  ls <path>");
      print("  cat <file>");
      print("  touch <path/nom.txt>");
      print("  mkdir <path/nom>");
      print("  rm <path>            (corbeille)");
      print("  restore <trashName>  (vers /Documents)");
      print("  open <app>           (explorer|notes|settings|easyjet|appmgr)");
      print("  ej list              (apps EJ installées)");
      print("  ej run <id>");
      print("  ej uninstall <id>");
      print("  clear");
    }

    function cmdTime(){
      print("Heure: " + fmtTime(new Date()));
      print("Mode: offline");
    }

    function cmdLs(arg){
      const p = resolvePath(arg || "/");
      const l = listDir(p);
      if(!l) return print("ls: dossier introuvable: "+p, "rgba(255,107,107,.9)");
      print(p + ":");
      l.forEach(n=> print("  " + n));
    }

    function cmdCat(arg){
      const p = resolvePath(arg);
      if(!isFile(p)) return print("cat: fichier introuvable: "+p, "rgba(255,107,107,.9)");
      const node = state.fs[p];
      print("----- "+p+" -----");
      (node.content || "").split("\n").forEach(line=>print(line));
      print("------------------");
    }

    function cmdTouch(arg){
      const p = resolvePath(arg);
      const pp = parentPath(p);
      if(!pp || !isDir(pp)) return print("touch: chemin invalide", "rgba(255,107,107,.9)");
      const name = baseName(p);
      if(state.fs[pp].children.includes(name)) return print("touch: existe déjà", "rgba(255,209,102,.9)");
      addChild(pp, name);
      state.fs[p] = {type:"file", mime:"text/plain", content:""};
      saveState();
      print("OK: créé " + p, "rgba(124,255,178,.9)");
    }

    function cmdMkdir(arg){
      const p = resolvePath(arg);
      const pp = parentPath(p);
      if(!pp || !isDir(pp)) return print("mkdir: parent invalide", "rgba(255,107,107,.9)");
      const name = baseName(p);
      if(state.fs[pp].children.includes(name)) return print("mkdir: existe déjà", "rgba(255,209,102,.9)");
      addChild(pp, name);
      state.fs[p] = {type:"dir", children:[]};
      saveState();
      print("OK: dossier créé " + p, "rgba(124,255,178,.9)");
    }

    function cmdRm(arg){
      const p = resolvePath(arg);
      if(!exists(p)) return print("rm: introuvable: "+p, "rgba(255,107,107,.9)");
      if(moveToTrash(p)) print("OK: envoyé dans /Corbeille", "rgba(124,255,178,.9)");
      else print("rm: impossible", "rgba(255,107,107,.9)");
    }

    function cmdRestore(arg){
      if(!arg) return print("restore: ex: restore MonFichier.txt", "rgba(255,209,102,.9)");
      const p = "/Corbeille/" + arg;
      if(!exists(p)) return print("restore: pas dans la corbeille: "+arg, "rgba(255,107,107,.9)");
      restoreFromTrash(p, "/Documents");
      print("OK: restauré vers /Documents", "rgba(124,255,178,.9)");
    }

    function cmdOpen(arg){
      const a = (arg||"").toLowerCase();
      if(a==="explorer") openExplorer("/");
      else if(a==="notes") openNotes();
      else if(a==="settings") openSettings();
      else if(a==="easyjet") openEasyJet();
      else if(a==="appmgr") openAppManager();
      else print("open: apps: explorer|notes|settings|easyjet|appmgr", "rgba(255,209,102,.9)");
    }

    function cmdEJ(rest){
      const [sub, ...args] = rest.trim().split(/\s+/);
      const s = (sub||"").toLowerCase();
      if(s==="list"){
        const list = Object.values(state.installedApps||{});
        if(!list.length) return print("Aucune app EJ installée.", "rgba(255,209,102,.9)");
        list.forEach(a=> print(`${a.id}  -  ${a.name}  (v${a.version||"1.0"})`));
        return;
      }
      if(s==="run"){
        const id = args.join(" ").trim();
        if(!id) return print("ej run <id>", "rgba(255,209,102,.9)");
        if(!state.installedApps?.[id]) return print("Introuvable: "+id, "rgba(255,107,107,.9)");
        openInstalledEJ(id);
        return;
      }
      if(s==="uninstall"){
        const id = args.join(" ").trim();
        if(!id) return print("ej uninstall <id>", "rgba(255,209,102,.9)");
        if(!state.installedApps?.[id]) return print("Introuvable: "+id, "rgba(255,107,107,.9)");
        uninstallEJ(id);
        print("Désinstallé: "+id, "rgba(124,255,178,.9)");
        return;
      }
      print("ej: subcommands: list | run <id> | uninstall <id>", "rgba(255,209,102,.9)");
    }

    function run(line){
      const t = line.trim();
      if(!t) return;
      print("sunset@os:~$ " + t, "rgba(124,231,255,.9)");
      const [cmd, ...rest] = t.split(/\s+/);
      const arg = rest.join(" ");

      switch(cmd){
        case "help": cmdHelp(); break;
        case "time": cmdTime(); break;
        case "ls": cmdLs(arg); break;
        case "cat": cmdCat(arg); break;
        case "touch": cmdTouch(arg); break;
        case "mkdir": cmdMkdir(arg); break;
        case "rm": cmdRm(arg); break;
        case "restore": cmdRestore(arg); break;
        case "open": cmdOpen(arg); break;
        case "ej": cmdEJ(arg); break;
        case "clear": out.innerHTML=""; break;
        default: print("Commande inconnue: "+cmd+" (help)", "rgba(255,107,107,.9)");
      }
    }

    inp.addEventListener("keydown", (e)=>{
      if(e.key==="Enter"){
        const v = inp.value;
        inp.value = "";
        run(v);
      }
    });

    print("SunsetOS Terminal v2");
    print("Tape 'help' pour la liste des commandes.");
    setTimeout(()=> inp.focus(), 50);

    makeWindow({
      title:"Terminal",
      badge:"⌘",
      contentNode: term,
      width: 780, height: 470,
      x: rand(90, 220), y: rand(40, 120),
      appId:"terminal"
    });
  }

  // -------------------- Easy Jet (Browser) --------------------
  function openEasyJet(){
    const wrap = document.createElement("div");
    wrap.style.width = "100%";
    wrap.style.display = "flex";
    wrap.style.flexDirection = "column";
    wrap.style.minHeight = "0";

    const bar = document.createElement("div");
    bar.className = "toolbar";
    bar.style.padding = "12px";
    bar.style.borderBottom = "1px solid rgba(255,255,255,.10)";
    bar.style.background = "rgba(255,255,255,.03)";

    const backBtn = document.createElement("button"); backBtn.className="btn"; backBtn.textContent="←";
    const fwdBtn  = document.createElement("button"); fwdBtn.className="btn";  fwdBtn.textContent="→";
    const reloadBtn=document.createElement("button"); reloadBtn.className="btn cyan"; reloadBtn.textContent="⟳";
    const homeBtn = document.createElement("button"); homeBtn.className="btn"; homeBtn.textContent="⌂";

    const url = document.createElement("input");
    url.className = "input";
    url.style.flex = "1";
    url.placeholder = "easyjet://home  ou  https://example.com";

    const goBtn  = document.createElement("button"); goBtn.className="btn good"; goBtn.textContent="GO";
    const favBtn = document.createElement("button"); favBtn.className="btn"; favBtn.textContent="★";

    bar.appendChild(backBtn); bar.appendChild(fwdBtn); bar.appendChild(reloadBtn);
    bar.appendChild(homeBtn); bar.appendChild(url); bar.appendChild(goBtn); bar.appendChild(favBtn);

    const body = document.createElement("div");
    body.style.flex="1"; body.style.minHeight="0"; body.style.display="flex";
    body.style.background="rgba(0,0,0,.12)";

    const side = document.createElement("div");
    side.style.width="230px"; side.style.minWidth="230px";
    side.style.borderRight="1px solid rgba(255,255,255,.10)";
    side.style.background="rgba(255,255,255,.03)";
    side.style.padding="12px"; side.style.overflow="auto";

    const sideTitle = document.createElement("div");
    sideTitle.style.fontWeight="900";
    sideTitle.style.marginBottom="10px";
    sideTitle.textContent="Favoris";

    const favList = document.createElement("div");
    favList.style.display="flex";
    favList.style.flexDirection="column";
    favList.style.gap="8px";

    side.appendChild(sideTitle);
    side.appendChild(favList);

    const view = document.createElement("div");
    view.style.flex="1"; view.style.minHeight="0";
    view.style.display="flex"; view.style.flexDirection="column";

    const info = document.createElement("div");
    info.style.fontSize="12px";
    info.style.color="rgba(255,255,255,.65)";
    info.style.padding="10px 12px";
    info.style.borderBottom="1px solid rgba(255,255,255,.08)";
    info.textContent="Astuce: certains sites bloquent l’affichage en iframe (normal).";

    const internal = document.createElement("div");
    internal.style.flex="1"; internal.style.minHeight="0";
    internal.style.display="none";
    internal.style.padding="14px";
    internal.style.overflow="auto";

    const frame = document.createElement("iframe");
    frame.style.flex="1"; frame.style.minHeight="0";
    frame.style.border="0";
    frame.style.width="100%";
    frame.style.background="rgba(0,0,0,.18)";
    frame.setAttribute("sandbox", "allow-forms allow-scripts allow-same-origin allow-popups");

    view.appendChild(info);
    view.appendChild(internal);
    view.appendChild(frame);

    body.appendChild(side);
    body.appendChild(view);

    wrap.appendChild(bar);
    wrap.appendChild(body);

    state.easyjet = state.easyjet || { favorites: ["easyjet://home", "easyjet://help", "https://example.com"] };

    let hist = [];
    let idx = -1;

    function normalizeInput(s){
      const t = (s||"").trim();
      if(!t) return "easyjet://home";
      if(t.startsWith("easyjet://")) return t;
      if(/^https?:\/\//i.test(t)) return t;
      return "https://" + t;
    }

    function setInternalPage(html){
      internal.style.display="block";
      frame.style.display="none";
      internal.innerHTML = html;
    }
    function setIframe(src){
      internal.style.display="none";
      frame.style.display="block";
      frame.src = src;
    }

    function renderFavs(){
      favList.innerHTML="";
      for(const f of state.easyjet.favorites){
        const b = document.createElement("button");
        b.className="btn";
        b.style.textAlign="left";
        b.style.width="100%";
        b.textContent=f;
        b.addEventListener("click", ()=> navigate(f, true));
        favList.appendChild(b);
      }

      const add = document.createElement("button");
      add.className="btn good";
      add.style.marginTop="10px";
      add.textContent="+ Ajouter favori";
      add.addEventListener("click", ()=>{
        const v = normalizeInput(url.value);
        if(!state.easyjet.favorites.includes(v)){
          state.easyjet.favorites.unshift(v);
          saveState();
          renderFavs();
        }
      });
      favList.appendChild(add);

      const del = document.createElement("button");
      del.className="btn bad";
      del.style.marginTop="8px";
      del.textContent="Supprimer favori…";
      del.addEventListener("click", ()=>{
        const v = prompt("Quel favori supprimer ? (URL exacte)");
        if(!v) return;
        state.easyjet.favorites = state.easyjet.favorites.filter(x => x !== v.trim());
        saveState();
        renderFavs();
      });
      favList.appendChild(del);
    }

    function esc(s){ return String(s).replace(/[&<>"]/g, m=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[m])); }

    function easyjetPage(route){
      route = (route||"home").toLowerCase();
      if(route==="home"){
        const favs = state.easyjet.favorites.map(f=>`<li><a href="#" data-nav="${esc(f)}">${esc(f)}</a></li>`).join("");
        return `
          <div style="font-weight:900;font-size:16px;margin-bottom:6px">Easy Jet</div>
          <div style="color:rgba(255,255,255,.70);font-size:12px;margin-bottom:14px">
            Navigateur SunsetOS • favoris persistants • iframe sandbox
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <button class="btn cyan" data-nav="easyjet://help">Aide</button>
            <button class="btn" data-nav="easyjet://about">À propos</button>
            <button class="btn good" data-nav="https://example.com">Page test</button>
          </div>
          <div class="card">
            <div style="font-weight:900;margin-bottom:8px">Favoris</div>
            <ul style="margin:0;padding-left:18px;line-height:1.6;font-size:12px;color:rgba(255,255,255,.75)">${favs}</ul>
          </div>
        `;
      }
      if(route==="help"){
        return `
          <div style="font-weight:900;font-size:16px;margin-bottom:6px">Aide — Easy Jet</div>
          <div style="color:rgba(255,255,255,.75);font-size:12px;line-height:1.5">
            • Tape une URL (ex: <b>example.com</b>) puis <b>GO</b><br>
            • Pages internes: <b>easyjet://home</b>, <b>easyjet://help</b>, <b>easyjet://about</b><br>
            • Certains sites refusent l’iframe (page blanche = normal).<br>
            • Favoris: ★ ajoute l’URL actuelle.
          </div>
        `;
      }
      if(route==="about"){
        return `
          <div style="font-weight:900;font-size:16px;margin-bottom:6px">À propos</div>
          <div style="color:rgba(255,255,255,.75);font-size:12px;line-height:1.5">
            Easy Jet v1<br>
            Rendu via iframe sandbox.<br>
            Stockage favoris: localStorage (SunsetOS).
          </div>
        `;
      }
      return `
        <div style="font-weight:900;font-size:16px;margin-bottom:6px">Page inconnue</div>
        <div style="color:rgba(255,255,255,.75);font-size:12px">Retour: <a href="#" data-nav="easyjet://home">easyjet://home</a></div>
      `;
    }

    function wireInternalLinks(){
      internal.querySelectorAll("[data-nav]").forEach(a=>{
        a.addEventListener("click", (e)=>{
          e.preventDefault();
          navigate(a.getAttribute("data-nav"), true);
        });
      });
    }

    function navigate(target, push){
      const n = normalizeInput(target);
      url.value = n;

      if(push){
        hist = hist.slice(0, idx+1);
        hist.push(n);
        idx++;
      }

      if(n.startsWith("easyjet://")){
        const route = n.slice("easyjet://".length).trim() || "home";
        setInternalPage(easyjetPage(route));
        wireInternalLinks();
        return;
      }
      setIframe(n);
    }

    backBtn.addEventListener("click", ()=>{ if(idx>0){ idx--; navigate(hist[idx], false); }});
    fwdBtn.addEventListener("click", ()=>{ if(idx<hist.length-1){ idx++; navigate(hist[idx], false); }});
    reloadBtn.addEventListener("click", ()=>{ if(idx>=0) navigate(hist[idx], false); else navigate(url.value, true); });
    homeBtn.addEventListener("click", ()=> navigate("easyjet://home", true));
    goBtn.addEventListener("click", ()=> navigate(url.value, true));
    url.addEventListener("keydown", (e)=>{ if(e.key==="Enter"){ e.preventDefault(); navigate(url.value, true);} });
    favBtn.addEventListener("click", ()=>{
      const v = normalizeInput(url.value);
      if(!state.easyjet.favorites.includes(v)){
        state.easyjet.favorites.unshift(v);
        saveState();
        renderFavs();
      }
    });

    renderFavs();
    navigate("easyjet://home", true);

    makeWindow({
      title:"Easy Jet",
      badge:"🚀",
      contentNode: wrap,
      width: 920, height: 560,
      x: rand(70, 180), y: rand(40, 110),
      appId:"easyjet"
    });
  }

  // -------------------- App Manager --------------------
  function openAppManager(){
    const wrap = document.createElement("div");
    wrap.className = "settings"; // reuse spacing

    const top = document.createElement("div");
    top.className = "toolbar";

    const refreshBtn = document.createElement("button");
    refreshBtn.className = "btn cyan";
    refreshBtn.textContent = "Rafraîchir";

    const wipeBtn = document.createElement("button");
    wipeBtn.className = "btn bad";
    wipeBtn.textContent = "Tout désinstaller";

    top.appendChild(refreshBtn);
    top.appendChild(wipeBtn);

    const card = document.createElement("div");
    card.className = "card";

    const title = document.createElement("div");
    title.style.fontWeight="900";
    title.textContent = "Apps installées (.EJ)";

    const listWrap = document.createElement("div");
    listWrap.style.display="flex";
    listWrap.style.flexDirection="column";
    listWrap.style.gap="8px";

    card.appendChild(title);
    card.appendChild(listWrap);

    wrap.appendChild(top);
    wrap.appendChild(card);

    function render(){
      listWrap.innerHTML = "";
      const apps = Object.values(state.installedApps || {}).sort((a,b)=>a.name.localeCompare(b.name,"fr"));
      if(!apps.length){
        const p = document.createElement("div");
        p.style.color="rgba(255,255,255,.65)";
        p.style.fontSize="12px";
        p.textContent = "Aucune app installée. (Astuce: Téléchargements → Demo.EJ)";
        listWrap.appendChild(p);
        return;
      }
      for(const a of apps){
        const row = document.createElement("div");
        row.className = "trow";
        row.innerHTML = `
          <div>
            <div class="name">${a.icon || "📦"} ${a.name}</div>
            <div class="meta">ID: ${a.id} • v${a.version || "1.0"}</div>
          </div>
          <div class="meta">${(a.entryHtml?.length||0)} chars</div>
          <div class="actions"></div>
        `;
        const actions = $(".actions", row);

        const openBtn = document.createElement("button");
        openBtn.className="btn good";
        openBtn.textContent="Ouvrir";
        openBtn.addEventListener("click", ()=> openInstalledEJ(a.id));

        const delBtn = document.createElement("button");
        delBtn.className="btn bad";
        delBtn.textContent="Désinstaller";
        delBtn.addEventListener("click", ()=>{
          if(confirm(`Désinstaller ${a.name} ?`)){
            uninstallEJ(a.id);
            render();
          }
        });

        actions.appendChild(openBtn);
        actions.appendChild(delBtn);

        listWrap.appendChild(row);
      }
    }

    refreshBtn.addEventListener("click", ()=> render());
    wipeBtn.addEventListener("click", ()=>{
      if(confirm("Désinstaller TOUTES les apps .EJ ?")){
        state.installedApps = {};
        saveState();
        renderStartApps(startSearch.value || "");
        render();
      }
    });

    render();

    makeWindow({
      title:"App Manager",
      badge:"🧩",
      contentNode: wrap,
      width: 720, height: 460,
      x: rand(110, 240), y: rand(60, 150),
      appId:"appmgr"
    });
  }

  // -------------------- Settings --------------------
  function openSettings(){
    const wrap = document.createElement("div");
    wrap.className = "settings";

    const card1 = document.createElement("div");
    card1.className = "card";
    card1.innerHTML = `<div style="font-weight:900">Interface</div>`;

    const glowRow = document.createElement("div");
    glowRow.className="row";
    glowRow.innerHTML = `<div class="k">Glow du wallpaper</div><div class="switch"><div class="knob"></div></div>`;
    const glowSwitch = $(".switch", glowRow);
    glowSwitch.classList.toggle("on", !!state.theme.glow);

    const compactRow = document.createElement("div");
    compactRow.className="row";
    compactRow.innerHTML = `<div class="k">Mode compact (icônes)</div><div class="switch"><div class="knob"></div></div>`;
    const compactSwitch = $(".switch", compactRow);
    compactSwitch.classList.toggle("on", !!state.theme.compact);

    const resetRow = document.createElement("div");
    resetRow.className="row";
    resetRow.innerHTML = `<div class="k">Réinitialiser</div><button class="btn bad">Reset storage</button>`;
    const resetBtn = $(".btn", resetRow);

    card1.appendChild(glowRow);
    card1.appendChild(compactRow);
    card1.appendChild(resetRow);

    const card2 = document.createElement("div");
    card2.className="card";
    card2.innerHTML = `
      <div style="font-weight:900">Système</div>
      <div class="row"><div class="k">Mode</div><div class="v">Offline</div></div>
      <div class="row"><div class="k">Stockage</div><div class="v">localStorage</div></div>
      <div class="row"><div class="k">Apps EJ</div><div class="v">${Object.keys(state.installedApps||{}).length}</div></div>
    `;

    wrap.appendChild(card1);
    wrap.appendChild(card2);

    glowSwitch.addEventListener("click", ()=>{
      state.theme.glow = !state.theme.glow;
      glowSwitch.classList.toggle("on", state.theme.glow);
      applyTheme();
      saveState();
    });

    compactSwitch.addEventListener("click", ()=>{
      state.theme.compact = !state.theme.compact;
      compactSwitch.classList.toggle("on", state.theme.compact);
      applyTheme();
      saveState();
    });

    resetBtn.addEventListener("click", ()=>{
      if(confirm("Supprimer tout (fichiers + notes + apps EJ) ?")){
        localStorage.removeItem(LS_KEY);
        location.reload();
      }
    });

    makeWindow({
      title:"Paramètres",
      badge:"⚙️",
      contentNode: wrap,
      width: 660, height: 440,
      x: rand(110, 240), y: rand(60, 140),
      appId:"settings"
    });
  }

  // -------------------- About --------------------
  function openAbout(){
    const wrap = document.createElement("div");
    wrap.style.width="100%";
    wrap.style.padding="12px";
    wrap.style.display="flex";
    wrap.style.flexDirection="column";
    wrap.style.gap="10px";
    wrap.style.minHeight="0";

    const card = document.createElement("div");
    card.className="card";
    card.innerHTML = `
      <div style="font-weight:900">SunsetOS</div>
      <div style="color:rgba(255,255,255,.75); font-size:12px; line-height:1.35">
        OS web offline: fenêtres, explorateur, terminal, notes, Easy Jet, apps .EJ.
      </div>
      <div class="row"><div class="k">Version</div><div class="v">2.0</div></div>
      <div class="row"><div class="k">Langue</div><div class="v">${navigator.language}</div></div>
      <div class="row"><div class="k">Apps EJ</div><div class="v">${Object.keys(state.installedApps||{}).length}</div></div>
    `;
    wrap.appendChild(card);

    makeWindow({
      title:"À propos",
      badge:"ℹ️",
      contentNode: wrap,
      width: 560, height: 360,
      x: rand(140, 260), y: rand(70, 160),
      appId:"about"
    });
  }

  // -------------------- Message dialog --------------------
  function openMessage(title, text){
    const wrap = document.createElement("div");
    wrap.style.width="100%";
    wrap.style.padding="12px";
    wrap.style.display="flex";
    wrap.style.flexDirection="column";
    wrap.style.gap="10px";

    const card = document.createElement("div");
    card.className="card";
    card.innerHTML = `<div style="font-weight:900">${title}</div><div style="font-size:12px;color:rgba(255,255,255,.75);white-space:pre-wrap;line-height:1.35"></div>`;
    card.querySelector("div:last-child").textContent = text;

    const ok = document.createElement("button");
    ok.className="btn cyan";
    ok.textContent="OK";

    wrap.appendChild(card);
    wrap.appendChild(ok);

    const wid = makeWindow({ title, badge:"ℹ️", contentNode: wrap, width: 480, height: 270, x: rand(180, 320), y: rand(120, 220), appId:"msg" });
    ok.addEventListener("click", ()=> closeWindow(wid));
  }

  // -------------------- Start menu --------------------
  function renderStartApps(filter=""){
    startApps.innerHTML = "";
    const q = filter.trim().toLowerCase();

    const core = APPS.filter(a => !q || a.name.toLowerCase().includes(q) || a.desc.toLowerCase().includes(q));
    for(const app of core){
      const b = document.createElement("button");
      b.className = "appbtn";
      b.innerHTML = `<div class="mini">${app.icon}</div><div class="txt"><b>${app.name}</b><span>${app.desc}</span></div>`;
      b.addEventListener("click", ()=>{ closeStart(); app.open(); });
      startApps.appendChild(b);
    }

    // EJ installed apps
    const installed = Object.values(state.installedApps || {})
      .filter(a => !q || a.name.toLowerCase().includes(q) || a.id.toLowerCase().includes(q));

    for(const a of installed){
      const b = document.createElement("button");
      b.className = "appbtn";
      b.innerHTML = `<div class="mini">${a.icon || "📦"}</div><div class="txt"><b>${a.name}</b><span>EJ App • v${a.version||"1.0"} • ${a.id}</span></div>`;
      b.addEventListener("click", ()=>{ closeStart(); openInstalledEJ(a.id); });
      startApps.appendChild(b);
    }
  }

  function toggleStart(){
    startMenu.classList.toggle("open");
    if(startMenu.classList.contains("open")){
      startSearch.value = "";
      renderStartApps("");
      setTimeout(()=> startSearch.focus(), 20);
    }
  }
  function closeStart(){ startMenu.classList.remove("open"); }

  startBtn.addEventListener("click", (e)=>{ e.stopPropagation(); toggleStart(); });
  startSearch.addEventListener("input", ()=> renderStartApps(startSearch.value));
  window.addEventListener("click", (e)=>{
    if(!e.target.closest("#startMenu") && !e.target.closest("#startBtn")) closeStart();
  });

  // -------------------- Theme apply --------------------
  function applyTheme(){
    $("#wallpaper").style.display = state.theme.glow ? "block" : "none";
    if(state.theme.compact){
      desktop.style.gridTemplateColumns = "repeat(auto-fill, minmax(74px, 74px))";
      desktop.style.gridAutoRows = "86px";
      $$(".icon").forEach(ic=>{ ic.style.width="74px"; ic.style.height="86px"; });
    } else {
      desktop.style.gridTemplateColumns = "repeat(auto-fill, minmax(86px, 86px))";
      desktop.style.gridAutoRows = "96px";
      $$(".icon").forEach(ic=>{ ic.style.width=""; ic.style.height=""; });
    }
  }

  // -------------------- Taskbar actions --------------------
  showDeskBtn.addEventListener("click", ()=>{
    for(const [wid, obj] of windows){
      obj.minimized = true;
      obj.el.style.display = "none";
      const task = $(`.task[data-wid="${wid}"]`, taskMid);
      if(task) task.classList.remove("active");
    }
    focusNone();
    closeStart();
  });

  // -------------------- Clock + net --------------------
  function tick(){
    clockEl.textContent = fmtTime(new Date());
    netPill.innerHTML = navigator.onLine ? "<b>Online</b>" : "<b>Offline</b>";
  }
  window.addEventListener("online", tick);
  window.addEventListener("offline", tick);

  // -------------------- Boot --------------------
  function boot(){
    tick(); setInterval(tick, 1000);
    renderDesktop();
    renderStartApps("");
    applyTheme();
  }
  boot();

})();
</script>
</body>
</html>
